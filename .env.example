# Domain-Agnostic Subdomain Discovery Engine - Environment Variables
# Copy this file to .env and fill in your own keys.
# NEVER commit .env to version control.

# AlienVault OTX API key (optional - required for OTX passive DNS source)
OTX_API_KEY=your_otx_api_key_here

# urlscan.io API key (optional - required for urlscan.io search source)
URLSCAN_API_KEY=your_urlscan_api_key_here

# Certspotter API key (optional - higher rate limits)
CERTSPOTTER_API_KEY=your_certspotter_api_key_here

# Future keys can be added here:
